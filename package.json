{
  "name": "sloppi",
  "version": "0.0.2",
  "description": "A sandboxed Pi setup with ask mode and terminal UI customizations.",
  "keywords": [
    "pi-package",
    "pi",
    "sandbox"
  ],
  "homepage": "https://github.com/spence-s/sloppi",
  "bugs": {
    "url": "https://github.com/spence-s/sloppi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spence-s/sloppi.git"
  },
  "license": "MIT",
  "author": {
    "name": "Spencer Snyder",
    "email": "sasnyde2@gmail.com",
    "url": "https://spencersnyder.io"
  },
  "type": "module",
  "files": [
    "agent/extensions",
    "agent/themes"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "lint": "xo",
    "release": "np",
    "test": "node --test test/**/*",
    "test:coverage": "node --test --experimental-test-coverage test/**/*",
    "test:watch": "node --test --watch test/**/*",
    "update": "ncu -i && npm run update:playwright",
    "update:playwright": "npm install --save-exact @playwright/cli@latest playwright@$(npm view @playwright/cli@latest dependencies.playwright)"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.76",
    "@playwright/cli": "0.1.21",
    "execa": "^10.0.1",
    "object-deep-merge": "^2.0.1",
    "playwright": "1.63.0-alpha-2026-08-31",
    "typebox": "^1.3.30",
    "unbash": "^4.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "np": "^12.1.1",
    "npm-check-updates": "latest",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "xo": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": "^22.21.0 || >=24.5.0"
  },
  "pi": {
    "extensions": [
      "./agent/extensions/ask-mode.ts",
      "./agent/extensions/commit.ts",
      "./agent/extensions/staging/index.ts",
      "./agent/extensions/permissions/index.ts",
      "./agent/extensions/sandbox/index.ts",
      "./agent/extensions/startup-banner.ts",
      "./agent/extensions/shell-ui.ts",
      "./agent/extensions/zshrc.ts"
    ],
    "skills": [
      "./node_modules/@playwright/cli/skills"
    ],
    "themes": [
      "./agent/themes/dracula.json"
    ]
  }
}
