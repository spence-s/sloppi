{
  "name": "sloppi",
  "version": "0.1.0",
  "description": "A sandboxed Pi setup with ask mode and terminal UI customizations.",
  "license": "MIT",
  "repository": "github:spence-s/sloppi",
  "homepage": "https://github.com/spence-s/sloppi",
  "bugs": "https://github.com/spence-s/sloppi/issues",
  "author": "Spencer Snyder <sasnyde2@gmail.com> (https://spencersnyder.io)",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.21.0 || >=24.5.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "lint": "xo",
    "release": "np",
    "test": "node --test test/**/* && npm run test --workspaces --if-present",
    "test:coverage": "node --test --experimental-test-coverage test/**/* && npm run test:coverage --workspaces --if-present",
    "test:watch": "node --test --watch test/**/* packages/*/test/*.test.ts",
    "update": "ncu -i && npm run update:playwright",
    "update:playwright": "npm install --save-exact @playwright/cli@latest playwright@$(npm view @playwright/cli@latest dependencies.playwright)"
  },
  "files": [
    "agent/extensions",
    "agent/skills",
    "agent/themes"
  ],
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "sandbox"
  ],
  "dependencies": {
    "@playwright/cli": "0.1.22",
    "@sloppikit/sandbox": "file:packages/sandbox",
    "playwright": "1.64.0-alpha-1790635538000",
    "typebox": "^1.4.5",
    "unbash": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^26.6.6",
    "execa": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "np": "^12.1.1",
    "npm-check-updates": "^23.1.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "xo": "^5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "bundledDependencies": [
    "@sloppikit/sandbox"
  ],
  "pi": {
    "extensions": [
      "./agent/extensions/ask-mode.ts",
      "./agent/extensions/capture-request.ts",
      "./agent/extensions/commit.ts",
      "./agent/extensions/permissions/index.ts",
      "./agent/extensions/rendered-fetch.ts",
      "./node_modules/@sloppikit/sandbox/src/index.ts",
      "./agent/extensions/startup-banner.ts",
      "./agent/extensions/usage.ts",
      "./agent/extensions/shell-ui.ts",
      "./agent/extensions/zshrc.ts"
    ],
    "skills": [
      "./agent/skills",
      "./node_modules/@playwright/cli/skills"
    ],
    "themes": [
      "./agent/themes/dracula.json"
    ]
  }
}
