{
  "name": "sloppi",
  "version": "0.1.0",
  "description": "A sandboxed Pi setup with ask mode and terminal UI customizations.",
  "keywords": [
    "pi-package",
    "pi",
    "sandbox"
  ],
  "homepage": "https://github.com/spence-s/sloppi",
  "bugs": {
    "url": "https://github.com/spence-s/sloppi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spence-s/sloppi.git"
  },
  "license": "MIT",
  "author": {
    "name": "Spencer Snyder",
    "email": "sasnyde2@gmail.com",
    "url": "https://spencersnyder.io"
  },
  "type": "module",
  "files": [
    "agent/extensions"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "lint": "xo",
    "release": "np",
    "test": "PI_DEV=false node --test test/**/*",
    "test:coverage": "node --test --experimental-test-coverage test/**/*",
    "test:watch": "node --test --watch test/**/*",
    "update": "ncu -i"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.73",
    "execa": "^10.0.1",
    "object-deep-merge": "^2.0.1",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "np": "^12.0.1",
    "npm-check-updates": "latest",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "xo": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./agent/extensions/ask-mode.ts",
      "./agent/extensions/sloppi/index.ts",
      "./agent/extensions/startup-banner.ts",
      "./agent/extensions/status-line.ts"
    ]
  }
}
